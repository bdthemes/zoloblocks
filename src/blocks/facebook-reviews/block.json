{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "title": "Facebook Reviews",
    "name": "zolo/facebook-reviews",
    "category": "zoloblocks",
    "keywords": ["facebook", "reviews", "testimonials", "ratings", "social", "recommendations"],
    "description": "Display Facebook page reviews in beautiful card layouts.",
    "apiVersion": 3,
    "textdomain": "zoloblocks",
    "attributes": {
        "uniqueId": {
            "type": "string",
            "default": ""
        },
        "layoutType": {
            "type": "string",
            "default": "grid"
        },
        "zolo_fbReviewsColumnsRange": {
            "type": "number",
            "default": 3
        },
        "zolo_TABfbReviewsColumnsRange": {
            "type": "number",
            "default": 2
        },
        "zolo_MOBfbReviewsColumnsRange": {
            "type": "number",
            "default": 1
        },
        "zolo_fbReviewsGapGap": {
            "type": "number",
            "default": 20
        },
        "zolo_fbReviewsGapRowGap": {
            "type": "number"
        },
        "zolo_fbReviewsGapColGap": {
            "type": "number"
        },
        "zolo_TABfbReviewsGapGap": {
            "type": "number"
        },
        "zolo_TABfbReviewsGapRowGap": {
            "type": "number"
        },
        "zolo_TABfbReviewsGapColGap": {
            "type": "number"
        },
        "zolo_MOBfbReviewsGapGap": {
            "type": "number"
        },
        "zolo_MOBfbReviewsGapRowGap": {
            "type": "number"
        },
        "zolo_MOBfbReviewsGapColGap": {
            "type": "number"
        },
        "zolo_fbReviewsGapIsLinked": {
            "type": "boolean",
            "default": true
        },
        "zolo_fbReviewsGapUnit": {
            "type": "string",
            "default": "px"
        },
        "zolo_TABfbReviewsGapUnit": {
            "type": "string",
            "default": "px"
        },
        "zolo_MOBfbReviewsGapUnit": {
            "type": "string",
            "default": "px"
        },
        "reviewsPerPage": {
            "type": "number",
            "default": 6
        },
        "showAvatar": {
            "type": "boolean",
            "default": true
        },
        "showReviewerName": {
            "type": "boolean",
            "default": true
        },
        "showDate": {
            "type": "boolean",
            "default": true
        },
        "showRating": {
            "type": "boolean",
            "default": true
        },
        "showRecommendation": {
            "type": "boolean",
            "default": true
        },
        "showReviewText": {
            "type": "boolean",
            "default": true
        },
        "reviewTextLength": {
            "type": "number",
            "default": 150
        },
        "showReadMore": {
            "type": "boolean",
            "default": true
        },
        "readMoreText": {
            "type": "string",
            "default": "Read more"
        },
        "showHeader": {
            "type": "boolean",
            "default": true
        },
        "headerTitle": {
            "type": "string",
            "default": "Facebook Reviews"
        },
        "showWriteReviewBtn": {
            "type": "boolean",
            "default": true
        },
        "writeReviewBtnText": {
            "type": "string",
            "default": "Write a Review"
        },
        "writeReviewBtnUrl": {
            "type": "string",
            "default": ""
        },
        "showHeaderRating": {
            "type": "boolean",
            "default": true
        },
        "carouselAutoplay": {
            "type": "boolean",
            "default": true
        },
        "carouselSpeed": {
            "type": "number",
            "default": 3000
        },
        "carouselLoop": {
            "type": "boolean",
            "default": true
        },
        "resMode": {
            "type": "string",
            "default": "desktop"
        }
    },
    "example": {
        "attributes": {
            "preview": true
        },
        "viewportWidth": 800
    },
    "supports": {
        "anchor": false,
        "customClassName": false,
        "align": ["wide", "full"]
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "viewScript": "file:./frontend.js"
}
