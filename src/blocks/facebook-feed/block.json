{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "title": "Facebook Feed",
    "name": "zolo/facebook-feed",
    "category": "zoloblocks",
    "keywords": ["facebook", "feed", "social", "timeline", "posts", "social media"],
    "description": "Display Facebook posts in Timeline, Grid, Masonry or Carousel layouts.",
    "apiVersion": 3,
    "textdomain": "zoloblocks",
    "attributes": {
        "uniqueId": {
            "type": "string",
            "default": ""
        },
        "layoutType": {
            "type": "string",
            "default": "timeline"
        },
        "columns": {
            "type": "object",
            "default": {
                "desktop": 3,
                "tablet": 2,
                "mobile": 1
            }
        },
        "gap": {
            "type": "object",
            "default": {
                "desktop": 20,
                "tablet": 15,
                "mobile": 10
            }
        },
        "postsPerPage": {
            "type": "number",
            "default": 6
        },
        "showAvatar": {
            "type": "boolean",
            "default": true
        },
        "showAuthor": {
            "type": "boolean",
            "default": true
        },
        "showDate": {
            "type": "boolean",
            "default": true
        },
        "showContent": {
            "type": "boolean",
            "default": true
        },
        "contentLength": {
            "type": "number",
            "default": 150
        },
        "showReadMore": {
            "type": "boolean",
            "default": true
        },
        "readMoreText": {
            "type": "string",
            "default": "Read more"
        },
        "showReactions": {
            "type": "boolean",
            "default": true
        },
        "showComments": {
            "type": "boolean",
            "default": false
        },
        "showShares": {
            "type": "boolean",
            "default": false
        },
        "carouselAutoplay": {
            "type": "boolean",
            "default": true
        },
        "carouselSpeed": {
            "type": "number",
            "default": 3000
        },
        "carouselLoop": {
            "type": "boolean",
            "default": true
        },
        "facebookPageId": {
            "type": "string",
            "default": ""
        },
        "facebookAccessToken": {
            "type": "string",
            "default": ""
        },
        "cacheExpiration": {
            "type": "number",
            "default": 3600
        }
    },
    "example": {
        "attributes": {
            "preview": true
        },
        "viewportWidth": 800
    },
    "supports": {
        "anchor": false,
        "customClassName": false,
        "align": ["wide", "full"]
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "viewScript": "file:./frontend.js"
}
