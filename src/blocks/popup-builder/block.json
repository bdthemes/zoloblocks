{
    "apiVersion": 3,
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "title": "Popup Builder",
    "name": "zolo/popup-builder",
    "category": "zoloblocks",
    "keywords": ["Popup Builder"],
    "description": "build a site-wide popup.",
    "textdomain": "zoloblocks",
    "example": {
        "attributes": {
            "preview": true
        },
        "viewportWidth": 740
    },
    "supports": {
        "anchor": false,
        "customClassName": false,
        "align": ["wide", "full"],
        "zolo-popup" : true
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
