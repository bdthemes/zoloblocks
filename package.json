{
    "name": "zoloblocks",
    "version": "1.0.0",
    "description": "To start developing, simply follow the steps:-",
    "main": "index.js",
    "files": [
        "assets",
        "build",
        "dci",
        "includes",
        "languages",
        "vendor",
        "vendor-editor-bundle",
        "views",
        "*.php"
    ],
    "scripts": {
        "start": "wp-scripts start",
        "build": "wp-scripts build",
        "packages-update": "wp-scripts packages-update",
        "make-pot": "wp i18n make-pot . languages/zoloblocks.pot --exclude=node_modules,build,vendor,assets",
        "plugin-zip": "node ./packages/create-zip.js",
        "publish": "npm run build && npm run plugin-zip"
    },
    "author": "BdThemes",
    "license": "ISC",
    "prettier": {
        "printWidth": 140,
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": true,
        "trailingComma": "es5",
        "bracketSpacing": true,
        "jsxBracketSameLine": false,
        "arrowParens": "always",
        "endOfLine": "lf"
    },
    "dependencies": {
        "@codemirror/lang-css": "^6.3.0",
        "@dnd-kit/core": "^6.2.0",
        "@dnd-kit/sortable": "^9.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@lottiefiles/lottie-player": "^2.0.12",
        "@splinetool/react-spline": "^4.0.0",
        "@splinetool/runtime": "^1.9.46",
        "@uiw/react-codemirror": "^4.23.6",
        "@vis.gl/react-google-maps": "^1.4.0",
        "@wordpress/editor": "^14.16.0",
        "@wordpress/plugins": "^7.16.0",
        "@wordpress/server-side-render": "^5.16.0",
        "apexcharts": "^4.0.0",
        "bezier-easing-editor": "^0.8.0",
        "classnames": "^2.5.1",
        "cottonjs": "^1.3.6",
        "crypto-js": "^4.2.0",
        "fslightbox-react": "^1.7.6",
        "motion": "^11.13.1",
        "papaparse": "^5.4.1",
        "prop-types": "^15.8.1",
        "react-apexcharts": "^1.6.0",
        "react-compare-slider": "^3.1.0",
        "react-countup": "^6.5.3",
        "react-google-autocomplete": "^2.7.3",
        "react-lottie-player": "^2.1.0",
        "react-multi-select-component": "^4.3.4",
        "react-qrcode-logo": "^3.0.0",
        "react-select": "^5.8.3",
        "react-sortablejs": "^6.1.4",
        "react-window": "^1.8.11",
        "simple-parallax-js": "^6.0.1",
        "swiper": "^11.1.15",
        "uuid": "^11.0.3",
        "webfontloader": "^1.6.28"
    },
    "devDependencies": {
        "@wordpress/api-fetch": "^7.16.0",
        "@wordpress/prettier-config": "^4.16.0",
        "@wordpress/scripts": "^30.9.0"
    }
}
