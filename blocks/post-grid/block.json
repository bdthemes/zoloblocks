{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "title": "Post Grid",
    "name": "zolo/post-grid",
    "category": "zolo-blocks",
    "keywords": [
        "post",
        "post grid"
    ],
    "description": "post grid view",
    "apiVersion": 2,
    "textdomain": "zolo-blocks",
    "example": {
        "attributes": {
            "excerptWords": 15,
            "postQuery": {
                "postsPerPage": 1,
                "postType": "post",
                "orderBy": "date",
                "order": "desc"
            }
        }
    },
    "supports": {
        "anchor": false,
        "customClassName": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "editorScript": "zolo-block-editor-script"
}