{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "title": "Email",
    "name": "zolo/email",
    "category": "zoloblocks",
    "keywords": ["zolo", "email", "mail"],
    "description": "Email field block for Form Block",
    "apiVersion": 2,
    "textdomain": "zoloblocks",
    "parent": ["zolo/form"],
    "example": {
        "attributes": {
            "preview": true
        },
        "viewportWidth": 410
    },
    "usesContext": ["zolo/showFieldIcon"],
