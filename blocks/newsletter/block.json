{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "title": "Newsletter",
    "name": "zolo/newsletter",
    "category": "zoloblocks",
    "keywords": ["newsletter", "mailchimp", "zoloblocks"],
    "description": "Newsletter block for Zolo Blocks",
    "apiVersion": 2,
    "textdomain": "zoloblocks",
    "attributes": {
        "preview": true,
        "displayType": {
            "type": "string",
            "default": "row"
        },
        "inputButtonGap": {
            "type": "number",
            "default": 10
        },
        "stackOnMobile": {
            "type": "boolean",
            "default": true
        },
        "textSuccess": {
            "type": "string",
            "default": "Thank you for subscribing!"
        },
        "textSubscribed": {
            "type": "string",
            "default": "You're already subscribed with us!"
        },
        "provider": {
            "type": "string"
        },
        "mailchimpApiKey": {
            "type": "string"
        },
        "mailchimpListID": {
            "type": "string"
        },
        "textPosition": {
            "type": "string",
            "default": "left"
        }
    },
    "providesContext": {
        "zoloNewsletterDisplayType": "displayType",
        "zoloNewsletterStackOnMobile": "stackOnMobile"
    },
    "supports": {
        "anchor": false,
        "customClassName": false,
        "align": ["wide", "full"]
    },
    "editorScript": "zolo-block-editor-script"
}
